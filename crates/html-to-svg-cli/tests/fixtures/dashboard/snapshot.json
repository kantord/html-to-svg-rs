der-radius: 3px; }\n  code { font-family: \"DejaVu Sans Mono\", monospace; font-size: 12px; background: #eef0f6; padding: 1px 4px; border-radius: 4px; }\n  table { width: 100%; border-collapse: collapse; font-size: 13px; }\n  th { text-align: left; font-weight: 600; color: #6a7387; border-bottom: 2px solid #e3e6ee; padding: 6px 8px; }\n  td { padding: 7px 8px; border-bottom: 1px solid #eef0f6; }\n  td.num { text-align: right; font-variant-numeric: tabular-nums; }\n  .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }\n  .ok { background: #dcf5e6; color: #18794e; }\n  .warn { background: #fff1d6; color: #9a5b00; }\n  .stats { display: flex; gap: 12px; }\n  .stat { flex: 1; border-radius: 12px; padding: 12px; color: white; }\n  .stat b { display: block; font-size: 22px; }\n  .s1 { background: #2f80ed; } .s2 { background: #27ae60; } .s3 { background: #eb5757; opacity: .85; }\n  .clip { margin-top: 14px; height: 70px; border-radius: 16px; overflow: hidden; position: relative; background: #1d2433; }\n  .clip .bar { position: absolute; left: -20px; top: 18px; width: 140%; height: 34px; background: repeating-linear-gradient(45deg, #ffcc4d 0 14px, #1d2433 14px 28px); }\n  .badge { position: absolute; right: 26px; top: 86px; transform: rotate(-12deg); background: #ff4d6d; color: white; font-weight: 700; padding: 6px 12px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,.2); }\n  canvas { display: block; margin-top: 10px; border-radius: 10px; }\n  ul { margin: 0; padding-left: 18px; line-height: 1.6; }\n  li::marker { color: #7b3fe4; }\n  .note::before { content: \"Note: \"; font-weight: 700; color: #7b3fe4; }\n","BODY","rgb(243, 244, 248)","rgb(29, 36, 51)","Inter, sans-serif","14px","HEADER","data-testid","header","flex","linear-gradient(90deg, rgb(59, 43, 217), rgb(123, 63, 228))","24px","rgb(255, 255, 255)","512px 32px","\n  ","H1","71.5078px 12px","20px","700","Fleet overview","SPAN","29.5625px 8.5px","Week 44