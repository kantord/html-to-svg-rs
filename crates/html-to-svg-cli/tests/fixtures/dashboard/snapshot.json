: #7b3fe4; }\n  .note::before { content: \"Note: \"; font-weight: 700; color: #7b3fe4; }\n","BODY","rgb(243, 244, 248)","rgb(29, 36, 51)","Inter, sans-serif","14px","HEADER","data-testid","header","flex","linear-gradient(90deg, rgb(59, 43, 217), rgb(123, 63, 228))","rgb(255, 255, 255)","512px 32px","\n  ","H1","71.5078px 12px","20px","700","Fleet overview","SPAN","29.5625px 8.5px","Week 44","class","tag","env-tag","rgba(255, 255, 255, 0.2)","999px","30.8906px 11.5px","12px","staging","DIV","badge","rgb(255, 77, 109)","8px","rgba(0, 0, 0, 0.2) 0px 4px 10px 0px","matrix(0.978148, -0.207912, 0.207912, 0.978148, 0, 0)","27.4688px 14.5px","absolute","Beta","MAIN","grid","512px 186.391px","SECTION","card","summary","1px","rgb(227, 230, 238)","rgba(30, 40, 90, 0.1) 0px 6px 18px 0px","278.828px 166.391px","\n    ","H2","257.828px 9.5px","15px","600","Summary","P","257.828px 32.5312px","Throughput rose by ","MARK","highlight","inline","rgb(255, 229, 138)","0px 0px","12.4%"," after the scheduler change, while the\n      median latency stayed flat. Two regions still report ","CODE","rgb(238, 240, 246)","4px","\"DejaVu Sans Mono\", monospace","ERR_TIMEOUT"," during the nightly sync,\n      which is why the table below lists them separately.","note","257.828px 21.6875px","::before","rgb(123, 63, 228)","Note: ","before","This paragraph is long enough to wrap over several lines, so each line becomes its own\n      text node in Takumi with Chrome's exact position.","TABLE","regions","table","257.828px 64.5px","13px","\n      ","THEAD","table-header-group","257.828px 14.5px","TR","table-row","TH","table-cell","2px","rgb(106, 115, 135)","66.0391px 14.5px","Region","76.7031px 14.5px","Status","num","56.9062px 14.5px","Jobs","58.1797px 14.5px","p50 ms","TBODY","table-row-group","257.828px 49.75px","\n        ","row-eu","257.828px 16.75px","TD","66.0391px 16.75px","eu-west","76.7031px 16.75px","pill ok","inline-block","rgb(220, 245, 230)","rgb(24, 121, 78)","27.8203px 9px","11px","healt