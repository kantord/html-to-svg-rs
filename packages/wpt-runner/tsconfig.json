{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `page.evaluate(...)` callbacks run in the browser.
    "lib": ["es2023", "dom"],
    // Run by Node directly (type stripping): no emit, `.ts` imports, only erasable syntax.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
