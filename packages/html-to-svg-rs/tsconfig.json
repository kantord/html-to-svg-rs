{
  // The package is JavaScript (index.js and index.d.ts are generated by napi-rs): this checks
  // its tests against the generated types, as a user's code would be.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["test", "index.d.ts"]
}
