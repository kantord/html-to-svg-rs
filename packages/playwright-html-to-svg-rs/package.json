{
  "name": "playwright-html-to-svg-rs",
  "version": "0.1.0",
  "description": "SVG snapshots of pages under test in Playwright: Chrome lays the page out, html-to-svg paints it as SVG.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter html-to-svg-rs build:debug && playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "html-to-svg-rs": "workspace:*"
  }
}
