{
  "name": "playwright-html-to-svg-rs",
  "version": "0.1.0",
  "description": "SVG snapshots of pages under test in Playwright: Chrome lays the page out, html-to-svg paints it as SVG.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cli": "cargo build -p html-to-svg-cli",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:cli && playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
