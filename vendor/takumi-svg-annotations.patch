diff --git a/src/lib.rs b/src/lib.rs
index 9500d0a..570d052 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -592,6 +592,15 @@ impl SvgDocument {
     Ok(GroupToken::default())
   }
 
+  /// PATCH(html-to-svg): opens a `<g data-takumi-node="…">` around one paint chunk of a node that
+  /// carries an id, so a caller can map every piece of SVG back to the node it came from. A node's
+  /// paint is split into several chunks (background, content, outline) that may land far apart in
+  /// paint order, so each chunk gets its own group instead of one group per node.
+  pub(crate) fn begin_annotation_group(&mut self, node_id: &str) -> io::Result<GroupToken> {
+    self.open("g", &[("data-takumi-node", node_id.into())])?;
+    Ok(GroupToken::default())
+  }
+
   /// Opens an isolated group for [`SvgDocument::end_group`] to close.
   pub(crate) fn begin_isolate_group(&mut self) -> io::Result<GroupToken> {
     self.open("g", &[("style", "isolation:isolate".into())])?;
